# 64 hex chars — generate with: openssl rand -hex 32
MASTER_KEY=
# From console.upstash.com — REST API section of your Redis database.
# (When deployed with the Vercel marketplace Upstash integration, the injected
# KV_REST_API_URL / KV_REST_API_TOKEN variables are picked up automatically.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Number of trusted reverse-proxy hops between the real client and this app.
# The client IP is taken as the Nth-from-RIGHT entry of x-forwarded-for, so a
# client cannot spoof it by prepending fake leftmost entries. On Vercel the
# trusted x-real-ip header is preferred and this rarely matters. Default: 1.
#   1 = one trusted proxy in front (e.g. single nginx/Cloudflare) — typical.
#   2 = two trusted hops (e.g. CDN -> load balancer -> app).
TRUSTED_PROXY_HOPS=1

# Per-op Redis timeout (ms) on the request hot path. A slow/brown Redis must not
# hang requests up to the upstream timeout. AUTH lookups fail CLOSED on timeout
# (deny -> 401); rate limiters fail OPEN (allow). Default: 2000.
REDIS_TIMEOUT_MS=2000

# Config-record TTL in days. Every config is written with this expiry; an
# authenticated (in-use) config refreshes its TTL on each request, so active
# configs never lapse while abandoned ones expire after this idle window. This
# caps storage growth / economic-DoS via config spam. Default: 90.
CONFIG_TTL_DAYS=90

# Hard per-IP daily cap on config CREATION (POST /api/config), behind the 20/min
# IP limiter. A patient attacker can't mint configs indefinitely. Default: 50.
CONFIG_CREATE_DAILY_CAP=50
